{
  "name": "baton",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A neutral desk and scorekeeper for coding agents from different vendors: handoff packets, redlines and an outcome ledger. Never runs agents.",
  "bin": {
    "baton": "src/cli.ts"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "scripts": {
    "baton": "bun src/cli.ts",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome format --write .",
    "test": "bun test",
    "deps:check": "bun scripts/check-deps.ts",
    "check": "bun run deps:check && bun run typecheck && bun run lint && bun run test",
    "m0": "bun scripts/m0-check.ts",
    "build": "bun build src/cli.ts --compile --outfile dist/baton"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/bun": "1.4.5",
    "typescript": "7.0.2"
  }
}
