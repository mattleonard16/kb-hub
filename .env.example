# ---- Local (kb CLI, stdio MCP) ----
# Path to a local clone of your private `knowledge` repo.
KB_KNOWLEDGE_DIR=../knowledge
# Where the audit log and kill-switch file live (default ~/.kb). Never inside the knowledge repo.
KB_STATE_DIR=
# Override sync targets (default ~/.claude and ~/.codex).
KB_CLAUDE_HOME=
KB_CODEX_HOME=

# ---- Hosted (kb serve --http) ----
KB_PUBLIC_URL=https://kb-hub.fly.dev
# 32+ random characters: openssl rand -base64 48
KB_SIGNING_KEY=
# GitHub OAuth app (callback: $KB_PUBLIC_URL/oauth/github/callback)
KB_GITHUB_OAUTH_CLIENT_ID=
KB_GITHUB_OAUTH_CLIENT_SECRET=
# The only GitHub login allowed to sign in.
KB_ALLOWED_GITHUB_LOGIN=
# owner/knowledge. Read token clones it; write token commits flags to the inbox branch.
KB_GITHUB_REPO=
KB_GITHUB_READ_TOKEN=
KB_GITHUB_TOKEN=
KB_INBOX_BRANCH=inbox
# Secret for the knowledge repo's push webhook ($KB_PUBLIC_URL/hooks/github).
KB_WEBHOOK_SECRET=
# Browser origins allowed to call /mcp (server-to-server calls send none).
KB_ALLOWED_ORIGINS=https://chatgpt.com,https://claude.ai
# Kill switch and revocation for the hosted server: off | read-only | closed
KB_LOCKDOWN=off
KB_REVOKED_CLIENTS=
# Audit log file (default: stderr, which Fly keeps in its logs).
KB_AUDIT_LOG=
